<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="Robot_Arm_Urdf">
    <ros2_control name="RobotArmSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
            <param name="use_sim_time">true</param>
        </hardware>

        <joint name="Fixed_Base_rot_1">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="Rotary_Base_rot_2">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="BC_Connecting_Rod_rot_3">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="Jaw_Bracket_rot_6">
            <command_interface name="position"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="Jaw_Bracket_rot_9">
            <!-- URDF 里它是 Jaw_Bracket_rot_6 的 mimic 关节，由 robot_state_publisher
                 根据 mimic 关系推导，不能再单独下发命令，否则状态会和 URDF 打架。
                 这里只保留状态接口。 -->
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </ros2_control>
    </xacro:macro>
</robot>